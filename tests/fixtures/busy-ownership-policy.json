{
  "schema_version": "1.0",
  "live_authority": "standalone_busy_coordinator",
  "projection_surfaces": [
    "github_issue_title",
    "github_issue_comment",
    "branch",
    "pull_request",
    "process"
  ],
  "invariants": {
    "one_live_authority": true,
    "projection_never_creates_ownership": true,
    "stale_projection_non_blocking": true,
    "read_only_requires_claim": false,
    "shared_mutation_requires_exact_live_claim": true,
    "other_owner_claim_requires_yield": true,
    "coordination_outage_creates_no_fallback_authority": true,
    "read_only_and_independent_work_continue_during_coordination_outage": true,
    "substantive_investigation_requires_exact_live_claim": true,
    "ownership_claim_never_proves_worker_execution": true
  }
}
