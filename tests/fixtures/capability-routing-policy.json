{
  "schema_version": "1.0",
  "invariants": {
    "failure_scope": "capability_local",
    "transport_is_not_permission": true,
    "duplicate_authority_forbidden": true,
    "unrelated_capabilities_continue": true,
    "tool_names_live_outside_core_policy": true,
    "visible_surface_is_not_capability_boundary": true
  },
  "capabilities": {
    "coordination": {
      "ordered_adapter_roles": ["live_ownership"],
      "when_unavailable": "continue_read_only_and_independent_work",
      "fallback_mode": "no_second_authority"
    },
    "source_read": {
      "ordered_adapter_roles": ["source_native_read", "verified_local_read", "public_read"],
      "when_unavailable": "continue_other_capabilities",
      "fallback_mode": "ordered_supported_fallback"
    },
    "repository_mutate": {
      "ordered_adapter_roles": ["repo_native_write", "verified_local_repo_write"],
      "when_unavailable": "continue_read_only_and_other_capabilities",
      "fallback_mode": "ordered_supported_fallback"
    },
    "runtime_validate": {
      "ordered_adapter_roles": ["local_runtime_validation", "equivalent_ci_validation"],
      "when_unavailable": "preserve_unproven_status_and_continue_other_work",
      "fallback_mode": "ordered_supported_fallback"
    },
    "connected_account_action": {
      "ordered_adapter_roles": ["source_native_account_adapter"],
      "when_unavailable": "continue_other_capabilities",
      "fallback_mode": "none"
    },
    "artifact_create": {
      "ordered_adapter_roles": ["artifact_native_adapter"],
      "when_unavailable": "continue_other_capabilities",
      "fallback_mode": "none"
    },
    "schedule": {
      "ordered_adapter_roles": ["scheduler_adapter"],
      "when_unavailable": "continue_present_turn_work",
      "fallback_mode": "none"
    },
    "memory_read": {
      "ordered_adapter_roles": ["side_effect_free_memory_read"],
      "when_unavailable": "continue_without_memory",
      "fallback_mode": "none",
      "side_effects": "forbidden"
    },
    "memory_write": {
      "ordered_adapter_roles": ["audited_memory_write"],
      "when_unavailable": "continue_without_memory_write",
      "fallback_mode": "none",
      "requires": "explicit_user_authorization"
    }
  }
}
