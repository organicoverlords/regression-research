      ],
      "constraints": [],
      "available_roles": {
        "memory_read": ["side_effect_free_memory_read"],
        "memory_write": ["audited_memory_write"]
      },
      "failed_roles": {},
      "live_claims": [],
      "projections": [],
      "coordination_available": true,
      "explicit_user_authorization": false,
      "expected": {
        "directive_source": "current_user",
        "overall": "partial_progress",
        "dispositions": {"memory-read": "execute", "memory-write": "authorization_required"}
      }
    },
    {
      "id": "natural-explicit-memory-authorization-is-enough",
      "actor": "assistant",
      "directives": [
        {"source_class": "current_user", "directive": true, "text": "yes, update that saved entry"}
