{
  "classes": {
    "CURRENT_USER": 100,
    "LIVE_CANONICAL": 95,
    "VERIFIED_EVIDENCE": 90,
    "DURABLE_MEMORY": 75,
    "HISTORICAL_CONTEXT": 50,
    "RECOVERY_ONLY": 25
  },
  "sources": [
    {
      "class": "CURRENT_USER",
      "match_prefixes": [
        "user-instruction:"
      ]
    },
    {
      "class": "LIVE_CANONICAL",
      "match_prefixes": [
        "shared-policy:",
        "agents-policy:",
        "docs-policy:",
        "repo-policy:"
      ]
    },
    {
      "class": "VERIFIED_EVIDENCE",
      "match_prefixes": [
        "github:",
        "commit:",
        "p3:"
      ]
    },
    {
      "class": "VERIFIED_EVIDENCE",
      "match_prefixes": [
        "regression:",
        "incident:"
      ]
    },
    {
      "class": "LIVE_CANONICAL",
      "match_prefixes": [
        "spec:"
      ]
    },
    {
      "class": "DURABLE_MEMORY",
      "match_prefixes": [
        "durable-memory:",
        "aitube-memory:",
        "level6-memory:",
        "personal-context:"
      ]
    },
    {
      "class": "HISTORICAL_CONTEXT",
      "match_prefixes": [
        "claude-history:",
        "codex-history:",
        "nexus-memory:",
        "shared-policy-snapshot:"
      ]
    },
    {
      "class": "HISTORICAL_CONTEXT",
      "match_prefixes": [
        "opencode-history:",
        "opencode-log:"
      ]
    },
    {
      "class": "HISTORICAL_CONTEXT",
      "match_prefixes": [
        "command-code-history:",
        "command-code-log:"
      ]
    },
    {
      "class": "RECOVERY_ONLY",
      "match_prefixes": [
        "legacy-seed:",
        "memory-backup:"
      ]
    },
    {
      "class": "HISTORICAL_CONTEXT",
      "match_prefixes": [
        "traycer-history:",
        "traycer-review:"
      ]
    }
  ]
}
