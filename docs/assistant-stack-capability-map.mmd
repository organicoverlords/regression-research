flowchart LR
  subgraph HUMAN["WHAT YOU SHOULD SEE"]
    U["YOU\ncurrent goal"] --> CHAT["ChatGPT\norchestrate"] --> WORK["Workers\nbounded execution"] --> OUT["Result + proof"]
    OUT --> CHAT
  end

  subgraph RULES["RULES + CONTINUITY"]
    SP["Shared policy"]
    AG["Repo AGENTS.md"]
    NS["NORTH_STAR"]
    V["Vault / memory_bank.py"]
    PI["ChatGPT PI / saved memory"]
    SP --> AG
  end

  subgraph COORD["ONE COORDINATION AUTHORITY"]
    BC["Standalone BusyCoordinator\nclaims + exact-scope checkpoints + recovery"]
    STORE["canonical busy-claims.json"]
    BC --> STORE
  end

  subgraph EXEC["EXECUTION + PROOF"]
    ROUTE{"process route"}
    MCP["ChatGPTMcpClean / plugin2"]
    RDC["Remote Desktop Commander"]
    GIT["Local files + Git/worktrees"]
    GH["GitHub"]
    CI["GitHub Actions"]
    RT["Runtime / exact artifact"]    ROUTE --> MCP --> GIT
    ROUTE --> RDC --> GIT
    GIT --> GH --> CI
    GIT --> RT
  end

  subgraph OBS["DERIVED OBSERVABILITY"]
    OP["operator-live.json"]
    BOARD["DevProgressBoard"]
    OP -.-> BOARD
  end

  subgraph PROD["PRODUCT PIPELINE"]
    LOW["LowVRAM"] --> LIB["Asset Library"] --> P3["P3"]
    LOW --> LAB["TinyLab"] --> P3
    T3D["Tiny3D"] --> P3
  end

  U --> CHAT
  PI -.-> CHAT
  V -.-> CHAT
  AG --> CHAT
  NS --> CHAT
  CHAT --> BC
  WORK --> BC
  CHAT --> ROUTE
  WORK --> ROUTE
  BC -.-> OP
  GIT -.-> OP
  CI -.-> OP
  OP -.-> CHAT
  BOARD -.-> U
  classDef user fill:#111827,color:#fff,stroke:#111827,stroke-width:3px;
  classDef authority fill:#fef3c7,stroke:#b45309,stroke-width:3px;
  classDef route fill:#cffafe,stroke:#0e7490,stroke-width:2px,stroke-dasharray:5 3;
  classDef context fill:#f3e8ff,stroke:#7e22ce,stroke-width:2px;
  classDef evidence fill:#e5e7eb,stroke:#374151,stroke-width:2px;
  classDef projection fill:#dcfce7,stroke:#15803d,stroke-width:2px,stroke-dasharray:4 3;
  classDef product fill:#ecfccb,stroke:#4d7c0f,stroke-width:2px;

  class U user;
  class SP,AG,NS,BC,STORE authority;
  class ROUTE,MCP,RDC route;
  class V,PI context;
  class GIT,GH,CI,RT evidence;
  class OP,BOARD projection;
  class LOW,LIB,LAB,T3D,P3 product;