flowchart LR
  U["USER\ncurrent goal"] --> KNOW["KNOW\ninstruction + rules + context + live state"]
  KNOW --> COORD["COORDINATE\nBusyCoordinator ownership/jobs/checkpoints/handoffs"]
  COORD --> EXEC["EXECUTE\nworkers + replaceable routes + repos/tools"]
  EXEC --> REC["RECOVER\nroute-local failure + checkpoints + safe fallback"]
  REC --> PROVE["PROVE\nGit + GitHub + CI + runtime/artifacts"]
  EXEC --> PROVE
  PROVE --> RESULT["RESULT\nconcise evidence-backed report"]
  RESULT --> U

  subgraph RULES["KNOW — sources"]
    POLICY["shared policy"]
    AG["repo AGENTS.md"]
    NS["NORTH_STAR"]
    VAULT["Vault bootstrap / bounded history"]
    LIVE["live orientation"]
  end

  subgraph ROUTES["EXECUTE — replaceable transports"]
    MCP["ChatGPTMcpClean / plugin2"]
    RDC["Remote Desktop Commander"]
    LOCAL["local filesystem / Git / tools"]
  end

  POLICY --> KNOW
  AG --> KNOW
  NS --> KNOW
  VAULT --> KNOW
  LIVE --> KNOW

  MCP --> LOCAL
  RDC --> LOCAL
  LOCAL --> PROVE

  subgraph VIEWS["READ MODELS — observe, never command"]
    OP["operator-live.json"]
    BOARD["DevProgressBoard"]
  end
  COORD -.-> OP
  LOCAL -.-> OP
  PROVE -.-> OP
  OP -.-> BOARD
  OP -.-> KNOW

  subgraph PRODUCT["PRODUCT PIPELINE"]
    LOW["LowVRAM"]
    LIB["Asset Library"]
    LAB["TinyLab"]
    T3D["Tiny3D\nrelation to TinyLab NOT_PROVEN"]
    P3["P3"]
  end
  LOW --> LIB --> P3
  LOW --> LAB --> P3
  T3D --> P3

  classDef authority fill:#fef3c7,stroke:#b45309,stroke-width:3px;
  classDef route fill:#cffafe,stroke:#0e7490,stroke-width:2px,stroke-dasharray:5 3;
  classDef readmodel fill:#dcfce7,stroke:#15803d,stroke-width:2px,stroke-dasharray:3 3;
  classDef context fill:#f3e8ff,stroke:#7e22ce,stroke-width:2px;
  classDef product fill:#ecfccb,stroke:#4d7c0f,stroke-width:2px;
  class U,COORD authority;
  class MCP,RDC route;
  class OP,BOARD readmodel;
  class POLICY,AG,NS,VAULT,LIVE context;
  class LOW,LIB,LAB,T3D,P3 product;
